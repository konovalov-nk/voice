#!/usr/bin/env python3
from __future__ import annotations

import os
import shutil
import socket
import subprocess
import sys
from pathlib import Path


def runtime_sock() -> Path:
    runtime_root = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    return runtime_root / "recorderd" / "control.sock"


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: recorderctl {start|stop|toggle|status|ping|waybar|transcribe ...}", file=sys.stderr)
        return 2

    cmd = sys.argv[1]

    # local heavy commands (no daemon needed)
    if cmd == "transcribe":
        # prefer in PATH, then sibling next to this script (dev/git tree)
        transcribe = shutil.which("recorder-transcribe")
        if not transcribe:
            here = Path(__file__).resolve().parent
            cand = here / "recorder-transcribe"
            if cand.exists() and os.access(cand, os.X_OK):
                transcribe = str(cand)
        if not transcribe:
            transcribe = "recorder-transcribe"
        # forward everything after "transcribe", default to --last if nothing given
        extra = sys.argv[2:] or ["--last"]
        try:
            os.execvp(transcribe, [transcribe] + extra)
        except FileNotFoundError:
            print("error: recorder-transcribe not found (install it or put in PATH)", file=sys.stderr)
            return 127
        # never reached
        return 0

    if cmd not in {"start", "stop", "toggle", "status", "ping", "waybar"}:
        print("usage: recorderctl {start|stop|toggle|status|ping|waybar|transcribe ...}", file=sys.stderr)
        return 2

    sock_path = runtime_sock()

    if not sock_path.exists():
        print(f"error: socket not found: {sock_path}", file=sys.stderr)
        return 1

    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.connect(str(sock_path))
        client.sendall((cmd + "\n").encode("utf-8"))
        data = client.recv(1024)
    finally:
        client.close()

    out = data.decode("utf-8", errors="replace").strip()
    print(out)
    return 0 if not out.startswith("error:") else 1


if __name__ == "__main__":
    raise SystemExit(main())
