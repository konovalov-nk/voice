+def metrics_middleware(app):
+    """ASGI middleware: serve GET /metrics (Prometheus) without auth."""
+
+    async def wrapper(scope, receive, send):
+        if scope.get("type") == "http" and scope.get("path") == "/metrics" and scope.get("method") == "GET":
+            body = get_metrics_body()
+            await send({
+                "type": "http.response.start",
+                "status": 200,
+                "headers": [
+                    (b"content-type", get_metrics_content_type().encode()),
+                    (b"content-length", str(len(body)).encode()),
+                ],
+            })
+            await send({"type": "http.response.body", "body": body})
+            return
+        await app(scope, receive, send)
+
+    return wrapper
+
